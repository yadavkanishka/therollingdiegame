<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard - The Rolling Die</title>
</head>
<body>

    <h1>Manager Dashboard</h1>

    <h2>Discord Bot Activity</h2>

    <p>
        This section updates automatically when someone uses a Discord bot command.
    </p>

    <ul id="bot-activity">
        <li id="no-activity">Waiting for Discord bot activity...</li>
    </ul>

    <p>Welcome, {{username}}!</p>

    <p>

        <a href="/manager/games/add">Add a New Game</a>

    </p>

    <h2>Current Inventory</h2>

    {{#games}}

        <article>

            <h3>{{title}}</h3>

            <p>{{description}}</p>

            <p>Category: {{category}}</p>

            <p>Price: ${{price}}</p>

            <p>Stock: {{stock}}</p>
            
            <p><a href="/manager/games/{{id}}/edit">Edit Game</a></p>
            
            <form
                method="POST"
                action="/manager/games/{{id}}/delete"
                onsubmit="return confirm('Are you sure you want to delete this game?');">
                <button type="submit">Delete Game</button>
            </form>
        </article>

        <hr>

    {{/games}}

    {{^games}}

        <p>No games have been added yet.</p>

    {{/games}}

    <p><a href="/inventory">View Public Inventory</a></p>
    <p><a href="/logout">Log out</a></p>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/manager-dashboard.js"></script>

</body>
</html>