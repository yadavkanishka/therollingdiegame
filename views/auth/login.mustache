<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Login - The Rolling Die</title>
</head>
<body>

    <h1>Manager Login</h1>

    {{#error}}
        <p>{{error}}</p>
    {{/error}}

    <form method="POST" action="/login">

        <div>
            <label for="username">Username:</label>
            <input
                type="text"
                id="username"
                name="username"
                required
            >
        </div>

        <div>
            <label for="password">Password:</label>
            <input
                type="password"
                id="password"
                name="password"
                required
            >
        </div>

        <button type="submit">Log In</button>

    </form>

</body>
</html>