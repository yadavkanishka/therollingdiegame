<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard - The Rolling Die</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
    <nav>
        <a href="/manager" class="logo">🎲 The Rolling Die</a>
        <div>
            <a href="/">Home</a>
            <a href="/inventory">Inventory</a>
            <a href="/logout">Log out</a>
        </div>
    </nav>
</header>

<main>

    <div class="dashboard-header">
        <div>
            <h1>Manager Dashboard</h1>
            <p>Welcome, {{username}}! Manage your games and monitor Discord activity.</p>
        </div>

        <a href="/manager/games/add" class="button">
            + Add a New Game
        </a>
    </div>

    <section class="dashboard-panel">
        <h2>Discord Bot Activity</h2>

        <p>
            This section updates automatically when someone uses a Discord bot command.
        </p>

        <ul id="bot-activity">
            <li id="no-activity">Waiting for Discord bot activity...</li>
        </ul>
    </section>

    <section class="dashboard-panel">
        <h2>Current Inventory</h2>

        <div class="game-grid">
            {{#games}}
                <article class="game-card">
                    <h3>{{title}}</h3>

                    <p>{{description}}</p>

                    <p>
                        <span class="game-category">{{category}}</span>
                    </p>

                    <p class="game-price">${{price}}</p>

                    <p class="game-stock">Stock: {{stock}}</p>

                    <div class="dashboard-actions">
                        <a href="/manager/games/{{id}}/edit"
                           class="button button-secondary">
                            Edit Game
                        </a>

                        <form
                            method="POST"
                            action="/manager/games/{{id}}/delete"
                            onsubmit="return confirm('Are you sure you want to delete this game?');">

                            <button type="submit" class="button-danger">
                                Delete Game
                            </button>
                        </form>
                    </div>
                </article>
            {{/games}}
        </div>

        {{^games}}
            <p>No games have been added yet.</p>
        {{/games}}
    </section>

</main>

<footer>
    <p>&copy; The Rolling Die — Every game starts with a roll.</p>
</footer>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/manager-dashboard.js"></script>
</body>
</html>