<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Inventory - The Rolling Die</title>
</head>
<body>

    <h1>The Rolling Die Game Inventory</h1>

    {{#games}}
        <article>
            <h2>{{title}}</h2>
            <p>{{description}}</p>
            <p>Category: {{category}}</p>
            <p>Price: ${{price}}</p>
            <p>Stock: {{stock}}</p>
        </article>
        <hr>
    {{/games}}

</body>
</html>