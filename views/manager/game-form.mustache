<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{pageTitle}} - The Rolling Die</title>
    <link rel="stylesheet" href="/css/style.css">
<//head>
<body>

<!-- Navigation -->

    <header>

        <nav>

            <a href="/" class="logo">🎲 The Rolling Die</a>

            <div>

                <a href="/">Home</a>

                <a href="/inventory">Browse Games</a>

                <a href="/manager">Dashboard</a>

                <a href="/logout">Log out</a>

            </div>

        </nav>

    </header>

    <!-- Main Content -->

    <main>

        <section class="form-container">

            <h1>{{pageTitle}}</h1>

            <p>

                Enter the game information below to maintain your inventory.

            </p>

            <!-- Error Message -->

            {{#error}}

                <div class="login-error" role="alert">

                    {{error}}

                </div>

            {{/error}}

            <!-- Game Form -->

            <form method="POST" action="{{formAction}}">

                <div>

                    <label for="title">Game Title</label>

                    <input

                        type="text"

                        id="title"

                        name="title"

                        value="{{game.title}}"

                        placeholder="Enter game title"

                        required

                    >

                </div>

                <div>

                    <label for="description">Description</label>

                    <textarea

                        id="description"

                        name="description"

                        rows="4"

                        placeholder="Describe the game"

                        required

                    >{{game.description}}</textarea>

                </div>

                <div>

                    <label for="category">Category</label>

                    <input

                        type="text"

                        id="category"

                        name="category"

                        value="{{game.category}}"

                        placeholder="e.g. Strategy or Family"

                        required

                    >

                </div>

                <div>

                    <label for="price">Price ($)</label>

                    <input

                        type="number"

                        id="price"

                        name="price"

                        min="0"

                        step="0.01"

                        value="{{game.price}}"

                        placeholder="0.00"

                        required

                    >

                </div>

                <div>

                    <label for="stock">Stock Quantity</label>

                    <input

                        type="number"

                        id="stock"

                        name="stock"

                        min="0"

                        step="1"

                        value="{{game.stock}}"

                        placeholder="Enter available quantity"

                        required

                    >

                </div>

                <button type="submit">Save Game</button>

            </form>

            <p class="login-back">

                <a href="/manager">← Back to Dashboard</a>

            </p>

        </section>

    </main>

    <!-- Footer -->

    <footer>

        <p>&copy; The Rolling Die — Every game starts with a roll.</p>

    </footer>
</body>
</html>