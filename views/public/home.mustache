<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Rolling Die</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>

        <nav>

            <a href="/" class="logo">🎲 The Rolling Die</a>

            <div>

                <a href="/">Home</a>

                <a href="/inventory">Browse Games</a>

                <a href="/login">Manager Login</a>

            </div>

        </nav>

    </header>

    <main>

        <section class="hero">

            <h1>Welcome to <span class="highlight">The Rolling Die</span></h1>

            <p>

                Board games, good games, and good company.

                Find your next favourite game and make every game night memorable.

            </p>

            <div class="hero-actions">

                <a href="/inventory" class="button">

                    Browse Games

                </a>

                <a href="/login" class="button button-secondary">

                    Manager Login

                </a>

            </div>

        </section>

        <section>

            <h2>Let the Games Begin!</h2>

            <p>

                Explore our collection of board games, discover new favourites,

                and find something for your next game night.

            </p>

            <a href="/inventory" class="button">

                Explore Our Inventory

            </a>

        </section>

    </main>

    <footer>

        <p>&copy; The Rolling Die — Every game starts with a roll.</p>

    </footer>
</body>
</html>